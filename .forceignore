# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Org-generated or unrelated community metadata that is not part of QuickBridge 2GP
**/quickActions/GuestCommunityCase.quickAction-meta.xml
**/quickActions/NewCommunityCase.quickAction-meta.xml
**/flows/sfdc_default_ReportExport_Protection_Flow.flow-meta.xml

# Standard/deployment-only metadata retrieved from the development org.
# QuickBridge custom fields on standard objects remain packageable and are re-included.
**/layouts/*.layout-meta.xml
!**/layouts/*__c-*.layout-meta.xml
!**/layouts/*__mdt-*.layout-meta.xml
**/pages/**
**/staticresources/SiteSamples*

